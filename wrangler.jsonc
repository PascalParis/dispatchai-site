{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatchai-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Conserve les variables définies dans le dashboard Cloudflare lors des déploiements Git
  "keep_vars": true
  // Secrets à définir dans Cloudflare > Worker > Settings > Variables and Secrets :
  //   RESEND_API_KEY, DEMO_TO, DEMO_FROM : formulaire de démo (voir README.md)
}
